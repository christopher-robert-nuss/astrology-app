{
  "name": "simple-astrology-app",
  "version": "0.0.1",
  "main": "dist-electron/main.js",
  "private": true,
  "author": {
    "name": "Christopher Robert Nuss",
    "email": "chris@crn.net.au"
  },
  "homepage": "https://github.com/christopher-robert-nuss/astrology-app",
  "description": "A simple astrology app built with Vue 3, Vite, and Electron.",
  "desktopName": "Simple Astrology App",
  "build": {
    "appId": "com.crn.astrology-app",
    "productName": "Simple Astrology App",
    "extraResources": [
      {
        "from": "../backend/dist/astrology-backend",
        "to": "backend/astrology-backend"
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Other",
      "synopsis": "A simple astrology app built with Vue 3, Vite, and Electron.",
      "description": "A simple astrology app built with Vue 3, Vite, and Electron.",
      "maintainer": "Christopher Robert Nuss <chris@crn.net.au>",
      "vendor": "Christopher Robert Nuss",
      "mimeTypes": [
        "application/x-simple-astrology-app"
      ],
      "executableArgs": [
        "--enable-features=WebContentsFocusOnResize"
      ],
      "syncDesktopName": true
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "cross-env VITE_WEB_ONLY=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write --experimental-cli src/",
    "electron:dev": "vite",
    "electron:build": "cross-env NODE_ENV=production vite build && electron-builder --linux deb",
    "test": "vitest",
    "test:run": "vitest run",
    "pw:electron": "playwright test -c playwright.electron.config.js",
    "pw:electron:update": "playwright test -c playwright.electron.config.js --update-snapshots"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@primevue/forms": "^4.5.5",
    "@primevue/themes": "^4.5.4",
    "@tailwindcss/vite": "^4.3.1",
    "axios": "^1.18.1",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "tailwindcss": "^4.3.1",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@primevue/auto-import-resolver": "^4.5.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^24.1.0",
    "prettier": "3.8.4",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
